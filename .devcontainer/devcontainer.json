{
  "name": "DSH (DeepSeek Harness) Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install -g @deepseek-ai/dsh",
  "postStartCommand": "nohup dsh web --no-open > /tmp/dsh.log 2>&1 &",
  "forwardPorts": [
    3080
  ],
  "portsAttributes": {
    "3080": {
      "label": "DeepSeek Harness Web UI",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
