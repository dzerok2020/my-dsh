{
  "name": "DSH (DeepSeek Harness) Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "postCreateCommand": "npm config set allow-scripts=@deepseek-ai/dsh-subprocess-local,koffi,node-pty,@google/genai,protobufjs --location=user && npm install -g @deepseek-ai/dsh",
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/start-dsh.sh",
  "forwardPorts": [
    3081,
    3080
  ],
  "portsAttributes": {
    "3081": {
      "label": "DSH Web (open this)",
      "onAutoForward": "openPreview"
    },
    "3080": {
      "label": "DSH Web (direct, needs token)",
      "onAutoForward": "silent"
    }
  }
}
